# ========== الزامی ==========
# ورود به پنل (Basic Auth). اگر خالی باشد پنل 503 می‌دهد.
PANEL_USER=admin
PANEL_PASSWORD=change-me-to-a-long-random-string

# ========== پنل ==========
# روی Railway/Render خود پلتفرم PORT را می‌دهد. پیش‌فرض ایمیج: 3000
PORT=3000


# ========== ماندگاری ==========
# محل داده‌ها (روی Volume بگذارید). مثلاً Volume را روی /data مانت کنید.
TMPDIR=/data/tmp

# 1 = بعد از هر ری‌استارت، تونل خودکار وصل شود
# AUTO_START=1

# ========== واچ‌داگ و بهترین کانفیگ (اختیاری) ==========
WATCHDOG_TICK_SEC=5
WATCHDOG_INTERVAL_SEC=30
WATCHDOG_PROBE_TIMEOUT_SEC=10
WATCHDOG_MAX_FAILURES=3
WATCHDOG_STUCK_SEC=300
WATCHDOG_BACKOFF_BASE_SEC=2
WATCHDOG_BACKOFF_MAX_SEC=300
WATCHDOG_FALLBACK_AFTER=3
WATCHDOG_STABLE_SEC=60
BEST_TIMEOUT_SEC=45

# ========== اشتراک و Gateway ==========
# نام کاربری ۳ تا ۳۲ و رمز ۸ تا ۶۴ کاراکتر از A-Za-z0-9._~-
# اگر ندهید، در هر استارت تصادفی ساخته می‌شود.
# SHARE_USERNAME=myuser
# SHARE_PASSWORD=my-long-password
# 1 = با اتصال تونل، رله‌ها خودکار روشن شوند
# SHARE_AUTO=1
# پروتکل‌ها: socks, http, ss (فقط ss رمزنگاری‌شده است)
# SHARE_PROTOCOLS=socks,http,ss
# SS_CIPHER=chacha20-ietf-poly1305
# پورت محلی ثابت gateway (اختیاری)
# GATEWAY_PORT=10810

# ========== رله TCP (Railway TCP Proxy یا VPS) ==========
# باید با Application port در TCP Proxy یکی باشد و نباید PORT یا PORT+1 باشد.
# RELAY_PORT=10808
# RELAY_BIND_HOST=0.0.0.0
# این‌ها را Railway خودش می‌دهد؛ دستی ست نکنید:
# RAILWAY_TCP_PROXY_DOMAIN=
# RAILWAY_TCP_PROXY_PORT=
# RAILWAY_TCP_APPLICATION_PORT=
# خارج از Railway (مثلاً VPS) آدرس عمومی رله را خودتان بدهید:
# RELAY_PUBLIC_HOST=your.server.ip.or.domain
# RELAY_PUBLIC_PORT=10808

# ========== VLESS / Trojan روی WebSocket ==========
# vless, trojan (با کاما) یا off
# INBOUND_WS=vless,trojan
# مسیر مخفی WebSocket؛ با "/" شروع شود و /api/ یا /_next نباشد.
# INBOUND_WS_PATH=/my-secret-path
# دامنه‌ی عمومی در لینک‌ها (پیش‌فرض: دامنه‌ی Railway/Render)
# INBOUND_PUBLIC_HOST=panel.example.com
# INBOUND_PUBLIC_PORT=443
# 0 یا off = ws:// ساده
# INBOUND_TLS=1
# INBOUND_MAX_PER_IP=32
# GATEWAY_IDLE_SEC=600

# ========== اعلان‌ها ==========
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC...
# NOTIFY_TELEGRAM_CHAT_ID=123456789
# NOTIFY_TELEGRAM_API=https://api.telegram.org
# هشدار: subscription_changed شامل رمز رله است؛ فقط کانال خصوصی.
# NOTIFY_EVENTS=tunnel_down,subscription_changed,relay_error
# NOTIFY_COOLDOWN_SEC=300